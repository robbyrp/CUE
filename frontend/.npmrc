# npm configuration for the CUE frontend.
#
# legacy-peer-deps=true tells npm to use the pre-npm-7 peer-dependency
# algorithm: it INSTALLS peer deps but does NOT hard-fail when two packages
# disagree about a peer's version. We need this because Expo Router pulls in
# web-only libraries (radix/vaul -> react-dom) whose peer ranges are stricter
# than the exact React version Expo pins. That conflict is harmless for a
# mobile app, but npm 7+ would otherwise abort every install.
#
# Tradeoff: this disables npm's safety net for genuine peer conflicts too, so
# if a real incompatibility ever appears, npm won't shout about it — watch the
# Expo "npx expo-doctor" output instead.
legacy-peer-deps=true
